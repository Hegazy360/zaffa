{
  "name": "zaffa",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npx dotenvx run --env-file=.env.local --overload -- next dev",
    "dev:cron": "npx dotenvx run --env-file=.env.local -- node scripts/dev-cron.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:seed-e2e-users": "npx tsx prisma/seed-e2e-auth.ts",
    "db:seed-images": "npx dotenvx run --env-file=.env.local -- npx tsx prisma/seed-images.ts",
    "db:seed-outreach-templates": "npx dotenvx run --env-file=.env.local -- npx tsx prisma/seed-outreach-templates.ts",
    "db:migrate-images": "npx dotenvx run --env-file=.env.local --overload -- npx tsx scripts/migrate-design-images.ts",
    "dev:seed-notification": "npx dotenvx run --env-file=.env.local -- npx tsx scripts/seed-notification.ts",
    "dev:preview-emails": "npx dotenvx run --env-file=.env.local -- npx tsx scripts/preview-notification-emails.ts",
    "dev:seed-vision-packs": "npx dotenvx run --env-file=.env.local -- npx tsx scripts/seed-vision-pack-gallery.ts",
    "db:push": "prisma db push",
    "deploy:worker": "wrangler deploy --cwd workers/pinterest-search",
    "i18n:translate": "node scripts/translate-messages.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:local": "npx dotenvx run --env-file=.env.test -- playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "husky",
    "assets:compress": "node scripts/compress-home-assets.mjs"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "bash -c 'tsc -p tsconfig.json --noEmit'",
      "vitest related --run --passWithNoTests"
    ],
    "*.{js,mjs,cjs}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@formatjs/intl-localematcher": "^0.8.5",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@sentry/nextjs": "^10.51.0",
    "@sparticuz/chromium": "^149.0.0",
    "@stripe/stripe-js": "^8.9.0",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.98.0",
    "@tanstack/react-query": "^5.90.21",
    "@trpc/client": "^11.12.0",
    "@trpc/next": "^11.12.0",
    "@trpc/react-query": "^11.12.0",
    "@trpc/server": "^11.12.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.9.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "fast-png": "^8.0.0",
    "framer-motion": "^12.35.0",
    "html-to-image": "^1.11.13",
    "jpeg-js": "^0.4.4",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "next-intl": "^4.11.0",
    "openai": "^6.27.0",
    "pg": "^8.20.0",
    "posthog-js": "^1.372.6",
    "posthog-node": "^5.33.0",
    "prisma": "^7.4.2",
    "puppeteer-core": "^25.8.0",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.9.3",
    "shadcn": "^4.0.0",
    "sonner": "^2.0.7",
    "stripe": "^20.4.0",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/workers-types": "^4.20260429.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pg": "^8.18.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.5",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.5",
    "vitest-mock-extended": "^4.0.0",
    "wrangler": "^4.86.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "@prisma/engines@7.4.2": true,
    "@sentry/cli@2.58.5": true,
    "core-js@3.49.0": true,
    "esbuild@0.27.3": true,
    "fsevents@2.3.3": true,
    "fsevents@2.3.2": true,
    "msw@2.12.10": true,
    "@swc/core@1.15.18": true,
    "prisma@7.4.2": true,
    "protobufjs@7.5.6": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.11.1": true,
    "workerd@1.20260426.1": true
  }
}
