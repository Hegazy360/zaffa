generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector")]
}

enum UserRole {
  client
  planner
  vendor
  admin
}

enum EventType {
  wedding
  engagement
  birthday
  corporate
  other
}

enum EventStatus {
  draft
  planning
  confirmed
  in_progress
  completed
  cancelled
}

enum VendorCategory {
  catering
  photography
  videography
  flowers
  music
  decoration
  venue
  makeup
  fashion
  transportation
  other
}

enum BookingStatus {
  pending
  accepted
  declined
  completed
  cancelled
}

enum PaymentStatus {
  pending
  awaiting_payment
  processing
  paid
  failed
  refunded
  partially_refunded
  overdue
  cancelled
}

enum PaymentScheduleStatus {
  draft
  proposed
  active
  amended
  completed
  cancelled
}

enum AmendmentStatus {
  pending
  accepted
  rejected
  withdrawn
}

enum PayoutMethod {
  instapay
  wire
  cash
  other
}

enum PayoutRecipientType {
  planner
  vendor
}

enum VendorEngagementStatus {
  draft
  requested
  accepted
  declined
  active
  completed
  cancelled
}

enum VendorReleaseStatus {
  pending
  paid
  cancelled
}

enum ProposalStatus {
  pending
  accepted
  released
  declined
}

enum VisionPackStatus {
  pending_payment
  active
  fulfilled
  refunded
  expired
}

// Every user-facing notification is one of these. Grouped by the role most
// likely to receive it — but delivery is determined by the notify() call
// site, not the enum value.
enum NotificationType {
  // Client-facing
  proposal_received
  proposal_withdrawn
  planner_assigned
  payment_schedule_proposed
  payment_schedule_amendment_proposed
  payment_paid
  payment_failed
  payment_refunded
  payment_due_reminder
  payment_overdue
  // Planner-facing
  event_in_service_area
  proposal_accepted
  proposal_released
  schedule_amendment_decided
  payment_received
  payout_received
  vendor_accepted_engagement
  vendor_declined_engagement
  vendor_cancelled_engagement
  review_received
  payment_disputed
  // Vendor-facing
  engagement_requested
  engagement_cancelled
  engagement_items_updated
  // Shared (both parties of an event thread)
  message_received
  // Vision Pack lifecycle (couple-facing)
  vision_pack_ready
}

model Profile {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role                   UserRole  @default(client)
  full_name              String
  avatar_url             String?
  phone                  String?
  // Two-letter locale ("en", "ar"). Persisted server-side so the choice
  // follows the user across devices. Middleware seeds the cookie from
  // Accept-Language for anonymous visitors.
  locale                 String    @default("en")
  // Set to a timestamp when the user clicks the unsubscribe link in any
  // transactional email. In-app notifications are unaffected; we just stop
  // emailing them for everything.
  email_unsubscribed_at  DateTime?
  // Soft-delete request timestamps. `deletion_requested_at` is set when
  // the user clicks "Delete account" in settings; `deletion_scheduled_for`
  // is the date a background job will hard-delete the row. Sign-in is
  // refused while either is set so the grace period still gives them an
  // unmistakable signal that their account is being wound down.
  deletion_requested_at  DateTime?
  deletion_scheduled_for DateTime?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  planner_profile     PlannerProfile?
  vendor_profile      VendorProfile?
  client_events       Event[]            @relation("ClientEvents")
  sent_messages       Message[]
  reviews             Review[]           @relation("AuthorReviews")
  vendor_reviews      VendorReview[]     @relation("AuthorVendorReviews")
  style_quiz_sessions StyleQuizSession[]
  venue_designs       VenueDesign[]
  notifications       Notification[]
  bought_vision_packs VisionPack[]       @relation("PackBuyer")
  received_vision_packs VisionPack[]     @relation("PackRecipient")

  @@map("profiles")
}

model PlannerProfile {
  id              String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String                       @unique @db.Uuid
  business_name   String
  bio             String?
  location        String?
  specialties     Json                         @default("[]")
  // Structured service-area used by the "new event in your area" notification
  // fan-out. `service_cities` is a JSON array of lowercased city names; an
  // empty array disables area-based matching for this planner. Existing rows
  // default to empty + EG so we can roll the column out without a backfill.
  service_country String                       @default("EG")
  service_cities  Json                         @default("[]")
  avg_rating      Decimal                      @default(0) @db.Decimal(3, 2)
  review_count    Int                          @default(0)
  verified        Boolean                      @default(false)
  embedding       Unsupported("vector(1536)")?
  created_at      DateTime                     @default(now())
  updated_at      DateTime                     @updatedAt

  profile            Profile            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  events             Event[]            @relation("PlannerEvents")
  portfolio_items    PortfolioItem[]
  reviews            Review[]
  proposals          Proposal[]
  blocks             PlannerBlock[]
  payment_schedules  PaymentSchedule[]
  payouts            Payout[]
  vendor_engagements VendorEngagement[]
  vendor_releases    VendorRelease[]

  @@map("planner_profiles")
}

model VendorProfile {
  id            String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String                       @unique @db.Uuid
  business_name String
  category      VendorCategory
  location      String?
  bio           String?
  specialties   Json                         @default("[]")
  avg_rating    Decimal                      @default(0) @db.Decimal(3, 2)
  review_count  Int                          @default(0)
  verified      Boolean                      @default(false)
  embedding     Unsupported("vector(1536)")?
  created_at    DateTime                     @default(now())
  updated_at    DateTime                     @updatedAt

  profile         Profile               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  services        VendorService[]
  events          EventVendor[]
  portfolio_items VendorPortfolioItem[]
  reviews         VendorReview[]
  engagements     VendorEngagement[]
  releases        VendorRelease[]
  payouts         Payout[]

  @@map("vendor_profiles")
}

model VendorService {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendor_id      String   @db.Uuid
  name           String
  description    String?
  price_from     Decimal  @db.Decimal(10, 2)
  price_unit     String   @default("per_event")
  // Free-text refinement under the vendor's primary category
  // (e.g. "tea-light", "centerpiece"). Used in browse filters.
  subcategory    String?
  // Json array of Cloudinary URLs. Empty array = no images.
  images         Json     @default("[]")
  lead_time_days Int?
  // Soft-hide so vendors can pause an item without losing the row.
  available      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  vendor VendorProfile          @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  items  VendorEngagementItem[]

  @@index([vendor_id, available])
  @@map("vendor_services")
}

model VendorPortfolioItem {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendor_id  String     @db.Uuid
  image_url  String
  caption    String?
  event_type EventType?
  style_tags Json       @default("[]")
  created_at DateTime   @default(now())

  vendor VendorProfile @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  @@index([vendor_id])
  @@map("vendor_portfolio_items")
}

model VendorReview {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Author is the engaging planner (clients never see vendors). Stored as
  // Profile.id so we don't need a planner-only constraint at the DB layer.
  author_id     String   @db.Uuid
  vendor_id     String   @db.Uuid
  // Nullable so the same author can leave one review per (vendor, engagement)
  // and aggregate them at the vendor level.
  engagement_id String?  @db.Uuid
  rating        Int
  comment       String?
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now()) @updatedAt

  author     Profile           @relation("AuthorVendorReviews", fields: [author_id], references: [id], onDelete: Cascade)
  vendor     VendorProfile     @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  engagement VendorEngagement? @relation(fields: [engagement_id], references: [id], onDelete: SetNull)

  @@unique([author_id, vendor_id, engagement_id])
  @@index([vendor_id, rating])
  @@map("vendor_reviews")
}

model VendorEngagement {
  id           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id     String                 @db.Uuid
  planner_id   String                 @db.Uuid
  vendor_id    String                 @db.Uuid
  title        String
  notes        String?
  status       VendorEngagementStatus @default(requested)
  currency     String                 @default("EGP")
  // Recomputed from the line items on every mutation.
  total_amount Decimal                @db.Decimal(12, 2)
  requested_at DateTime?
  accepted_at  DateTime?
  completed_at DateTime?
  cancelled_at DateTime?
  created_at   DateTime               @default(now())
  updated_at   DateTime               @updatedAt

  event    Event                  @relation(fields: [event_id], references: [id], onDelete: Cascade)
  planner  PlannerProfile         @relation(fields: [planner_id], references: [id], onDelete: Cascade)
  vendor   VendorProfile          @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  items    VendorEngagementItem[]
  releases VendorRelease[]
  reviews  VendorReview[]

  @@index([event_id, status])
  @@index([planner_id, status])
  @@index([vendor_id, status])
  @@map("vendor_engagements")
}

model VendorEngagementItem {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  engagement_id String    @db.Uuid
  // Nullable when the item is a one-off custom row not in the vendor's catalog.
  service_id    String?   @db.Uuid
  name          String
  description   String?
  quantity      Int       @default(1)
  unit_price    Decimal   @db.Decimal(10, 2)
  line_total    Decimal   @db.Decimal(12, 2)
  delivered_at  DateTime?
  created_at    DateTime  @default(now())

  engagement VendorEngagement @relation(fields: [engagement_id], references: [id], onDelete: Cascade)
  service    VendorService?   @relation(fields: [service_id], references: [id], onDelete: SetNull)

  @@index([engagement_id])
  @@map("vendor_engagement_items")
}

model VendorRelease {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  engagement_id String              @db.Uuid
  planner_id    String              @db.Uuid
  vendor_id     String              @db.Uuid
  label         String
  amount        Decimal             @db.Decimal(12, 2)
  currency      String              @default("EGP")
  status        VendorReleaseStatus @default(pending)
  notes         String?
  requested_at  DateTime            @default(now())
  paid_at       DateTime?
  // Set when admin records the matching off-Stripe Payout.
  payout_id     String?             @db.Uuid

  engagement VendorEngagement @relation(fields: [engagement_id], references: [id], onDelete: Cascade)
  planner    PlannerProfile   @relation(fields: [planner_id], references: [id], onDelete: Cascade)
  vendor     VendorProfile    @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  payout     Payout?          @relation(fields: [payout_id], references: [id], onDelete: SetNull)

  @@index([planner_id, status])
  @@index([vendor_id, status])
  @@index([engagement_id])
  @@map("vendor_releases")
}

model Event {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id          String      @db.Uuid
  planner_id         String?     @db.Uuid
  title              String
  event_type         EventType
  event_date         DateTime?   @db.Date
  venue              String?
  budget             Decimal?    @db.Decimal(12, 2)
  status             EventStatus @default(draft)
  style_preferences  Json?
  ai_recommendations Json?
  created_at         DateTime    @default(now())
  updated_at         DateTime    @updatedAt

  client             Profile            @relation("ClientEvents", fields: [client_id], references: [id], onDelete: Cascade)
  planner            PlannerProfile?    @relation("PlannerEvents", fields: [planner_id], references: [id])
  vendors            EventVendor[]
  messages           Message[]
  designs            VenueDesign[]
  payments           Payment[]
  proposals          Proposal[]
  reviews            Review[]
  payment_schedules  PaymentSchedule[]
  vendor_engagements VendorEngagement[]
  vision_packs       VisionPack[]

  // Hot path: the marketplace teaser counts/fetches "open briefs"
  // (planner_id IS NULL). Without this we seq-scan `events` on every
  // home-page render. Composite with status because the second teaser
  // count filters by status as well.
  @@index([planner_id, status])
  @@map("events")
}

model EventVendor {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id     String        @db.Uuid
  vendor_id    String        @db.Uuid
  status       BookingStatus @default(pending)
  agreed_price Decimal?      @db.Decimal(10, 2)
  created_at   DateTime      @default(now())

  event  Event         @relation(fields: [event_id], references: [id], onDelete: Cascade)
  vendor VendorProfile @relation(fields: [vendor_id], references: [id])

  @@unique([event_id, vendor_id])
  @@map("event_vendors")
}

model PortfolioItem {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planner_id String     @db.Uuid
  image_url  String
  caption    String?
  event_type EventType?
  style_tags Json       @default("[]")
  created_at DateTime   @default(now())

  planner PlannerProfile @relation(fields: [planner_id], references: [id], onDelete: Cascade)

  @@map("portfolio_items")
}

model Review {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  author_id  String   @db.Uuid
  planner_id String   @db.Uuid
  event_id   String?  @db.Uuid
  rating     Int
  comment    String?
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  author  Profile        @relation("AuthorReviews", fields: [author_id], references: [id], onDelete: Cascade)
  planner PlannerProfile @relation(fields: [planner_id], references: [id], onDelete: Cascade)
  event   Event?         @relation(fields: [event_id], references: [id], onDelete: SetNull)

  // One review per (client, planner, event) so a couple can update their
  // existing review rather than stacking new rows after re-engagements.
  @@unique([author_id, planner_id, event_id])
  @@map("reviews")
}

model Message {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id   String   @db.Uuid
  sender_id  String   @db.Uuid
  content    String
  created_at DateTime @default(now())

  event  Event   @relation(fields: [event_id], references: [id], onDelete: Cascade)
  sender Profile @relation(fields: [sender_id], references: [id], onDelete: Cascade)

  @@map("messages")
}

enum InspirationCategory {
  overall_vibe
  flowers
  tables
  lighting
  venue_decor
}

model InspirationImage {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category      InspirationCategory
  subcategory   String
  image_url     String
  thumbnail_url String
  alt_text      String
  tags          Json                @default("[]")
  source        String              @default("unsplash")
  source_id     String?
  photographer  String?
  created_at    DateTime            @default(now())

  @@index([category, subcategory])
  @@map("inspiration_images")
}

model StyleQuizSession {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String   @db.Uuid
  answers      Json     @default("{}")
  ai_advice    Json     @default("{}")
  final_result Json?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  user Profile @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("style_quiz_sessions")
}

model VenueDesign {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.Uuid
  event_id    String?   @db.Uuid
  name        String    @default("Untitled Design")
  event_type  String    @default("wedding")
  setting     String    @default("indoor")
  // Coarse size bucket (intimate / medium / large) — kept for the AI scene
  // generator's layout descriptor. Derived on save from `guest_count` when
  // a precise count is provided; otherwise selected directly.
  size        String    @default("medium")
  // Exact expected guest count entered by the couple. Optional because
  // older designs were captured before this field existed.
  guest_count Int?
  palette     Json      @default("{}")
  references  Json      @default("{}")
  style_notes String?
  thumbnail   String?
  approved_at DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  user  Profile            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  event Event?             @relation(fields: [event_id], references: [id], onDelete: SetNull)
  media VenueDesignMedia[]

  // Marketplace teaser joins event → designs and filters approved_at IS
  // NOT NULL. Composite (event_id, approved_at) supersedes the bare
  // event_id index for the EXISTS subquery in the teaser count and is
  // still usable for any lookup that filters on event_id alone.
  @@index([event_id, approved_at])
  @@map("venue_designs")
}

model VenueDesignMedia {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  design_id  String   @db.Uuid
  // For videos: id of the render (also a VenueDesignMedia row) the video was
  // generated from. NULL for renders themselves and for legacy videos from
  // before this column existed.
  parent_id  String?  @db.Uuid
  type       String
  url        String
  created_at DateTime @default(now())

  design   VenueDesign        @relation(fields: [design_id], references: [id], onDelete: Cascade)
  parent   VenueDesignMedia?  @relation("MediaParent", fields: [parent_id], references: [id], onDelete: SetNull)
  children VenueDesignMedia[] @relation("MediaParent")

  @@map("venue_design_media")
}

model Payment {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id    String        @db.Uuid
  // Nullable so legacy manual ledger rows still load. New rows created from
  // a PaymentSchedule always reference a schedule.
  schedule_id String?       @db.Uuid
  label       String
  amount      Decimal       @db.Decimal(10, 2)
  currency    String        @default("EGP")
  status      PaymentStatus @default(pending)
  due_date    DateTime?
  paid_at     DateTime?
  notes       String?

  // Stripe linkage. All nullable until the client opens a Checkout session.
  stripe_checkout_session_id String?
  stripe_payment_intent_id   String?
  stripe_charge_id           String?
  stripe_refund_id           String?

  // Cached at capture time so we don't recompute on every read and so the
  // amounts are stable even if the schedule's fee_pct changes later.
  platform_fee_amount   Decimal? @db.Decimal(10, 2)
  net_to_planner_amount Decimal? @db.Decimal(10, 2)

  // Cumulative amount refunded across all `PaymentRefund` rows for this
  // installment. Maintained by the refund flow; lets us tell partial vs
  // full refunds without scanning the ledger on every read.
  refunded_amount Decimal @default(0) @db.Decimal(10, 2)

  // Set when an admin records a Payout that includes this installment.
  payout_id String? @db.Uuid

  // Dispute lifecycle.
  // - `disputed_at`: set on charge.dispute.created
  // - `dispute_status`: latest known status from Stripe
  //   (warning_needs_response / under_review / won / lost / charge_refunded)
  // - `dispute_resolved_at`: set when dispute closes (won/lost)
  disputed_at         DateTime?
  dispute_status      String?
  dispute_resolved_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  event    Event            @relation(fields: [event_id], references: [id], onDelete: Cascade)
  schedule PaymentSchedule? @relation(fields: [schedule_id], references: [id], onDelete: SetNull)
  payout   Payout?          @relation(fields: [payout_id], references: [id], onDelete: SetNull)
  refunds  PaymentRefund[]

  @@index([event_id])
  @@index([schedule_id])
  @@index([payout_id])
  @@map("payments")
}

model PaymentSchedule {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id         String                @db.Uuid
  proposal_id      String                @db.Uuid
  planner_id       String                @db.Uuid
  client_id        String                @db.Uuid
  currency         String                @default("EGP")
  total_amount     Decimal               @db.Decimal(12, 2)
  platform_fee_pct Decimal               @default(8.0) @db.Decimal(5, 2)
  status           PaymentScheduleStatus @default(draft)
  accepted_at      DateTime?
  cancelled_at     DateTime?
  created_at       DateTime              @default(now())
  updated_at       DateTime              @updatedAt

  event        Event               @relation(fields: [event_id], references: [id], onDelete: Cascade)
  proposal     Proposal            @relation(fields: [proposal_id], references: [id], onDelete: Cascade)
  planner      PlannerProfile      @relation(fields: [planner_id], references: [id], onDelete: Cascade)
  installments Payment[]
  amendments   ScheduleAmendment[]

  @@index([event_id])
  @@index([planner_id])
  @@index([proposal_id])
  @@map("payment_schedules")
}

model ScheduleAmendment {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schedule_id           String          @db.Uuid
  requested_by_user_id  String          @db.Uuid
  // Snapshot of the proposed not-yet-paid installments. Shape:
  // [{ label: string, amount: number, due_date: string | null }]
  proposed_installments Json
  proposed_total        Decimal         @db.Decimal(12, 2)
  proposed_fee_pct      Decimal?        @db.Decimal(5, 2)
  reason                String?
  status                AmendmentStatus @default(pending)
  decided_at            DateTime?
  decided_by_user_id    String?         @db.Uuid
  created_at            DateTime        @default(now())
  updated_at            DateTime        @updatedAt

  schedule PaymentSchedule @relation(fields: [schedule_id], references: [id], onDelete: Cascade)

  @@index([schedule_id, status])
  @@map("schedule_amendments")
}

model Payout {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Either planner_id or vendor_id must be set depending on recipient_type.
  // We keep planner_id nullable now to support vendor-recipient payouts; the
  // tRPC layer enforces the "exactly one is set" invariant.
  planner_id          String?             @db.Uuid
  vendor_id           String?             @db.Uuid
  recipient_type      PayoutRecipientType @default(planner)
  currency            String              @default("EGP")
  amount              Decimal             @db.Decimal(12, 2)
  method              PayoutMethod        @default(instapay)
  reference           String?
  notes               String?
  paid_at             DateTime
  recorded_by_user_id String              @db.Uuid
  created_at          DateTime            @default(now())

  planner         PlannerProfile? @relation(fields: [planner_id], references: [id], onDelete: Cascade)
  vendor          VendorProfile?  @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  installments    Payment[]
  vendor_releases VendorRelease[]

  @@index([planner_id, paid_at])
  @@index([vendor_id, paid_at])
  @@map("payouts")
}

model Proposal {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id        String         @db.Uuid
  planner_id      String         @db.Uuid
  cover_letter    String
  quote_amount    Decimal?       @db.Decimal(12, 2)
  quote_currency  String         @default("EGP")
  quote_breakdown Json?
  status          ProposalStatus @default(pending)
  accepted_at     DateTime?
  released_at     DateTime?
  release_reason  String?
  release_rating  Int?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  event             Event             @relation(fields: [event_id], references: [id], onDelete: Cascade)
  planner           PlannerProfile    @relation(fields: [planner_id], references: [id], onDelete: Cascade)
  payment_schedules PaymentSchedule[]

  @@unique([event_id, planner_id])
  @@index([planner_id, status])
  @@index([event_id, status])
  @@map("proposals")
}

model PlannerBlock {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planner_id String   @db.Uuid
  start_date DateTime @db.Date
  end_date   DateTime @db.Date
  reason     String?
  created_at DateTime @default(now())

  planner PlannerProfile @relation(fields: [planner_id], references: [id], onDelete: Cascade)

  @@index([planner_id, start_date])
  @@map("planner_blocks")
}

// ----- Prospecting pipeline -----
//
// We treat planners and vendors that *don't have an account yet* as
// Prospects. Discovery jobs ingest them from public sources; an admin can
// also enter them manually. Outreach is fully manual — we draft the
// message, the admin copies + sends it.

enum ProspectSource {
  instagram
  tiktok
  facebook
  directory
  web
  manual
}

enum ProspectType {
  planner
  vendor
  unknown
}

enum ProspectStatus {
  new
  qualified
  drafted
  contacted
  replied
  signed_up
  rejected
}

enum DiscoveryRunStatus {
  queued
  running
  completed
  failed
}

model Prospect {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source            ProspectSource
  // ID assigned by the source (e.g. IG user id, FB page id). Combined with
  // `source` it gives us a stable cross-run identity for upserts.
  source_id         String?
  source_url        String?
  display_name      String
  // Public handle (IG/TikTok username, FB page slug, etc.).
  handle            String?
  prospect_type     ProspectType    @default(unknown)
  vendor_category   VendorCategory?
  email             String?
  whatsapp          String?
  phone             String?
  instagram         String?
  facebook          String?
  tiktok            String?
  website           String?
  bio               String?
  city              String?
  country           String?         @default("EG")
  followers         Int?
  avatar_url        String?
  // Cloudinary / source URLs of representative work.
  sample_images     Json            @default("[]")
  status            ProspectStatus  @default(new)
  // 0–100 LLM-assigned signal-quality score (higher = better fit).
  qualifying_score  Int?
  notes             String?
  draft_email       String?
  draft_whatsapp    String?
  draft_instagram   String?
  contacted_at      DateTime?
  contacted_via     String?
  replied_at        DateTime?
  // Filled by the signup matcher when this prospect creates an account.
  signed_up_user_id String?         @unique @db.Uuid
  // Verbatim payload from the source row for forensics/debugging.
  raw_payload       Json?
  discovery_run_id  String?         @db.Uuid
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt
  last_seen_at      DateTime?

  discovery_run DiscoveryRun? @relation(fields: [discovery_run_id], references: [id], onDelete: SetNull)

  @@unique([source, source_id])
  @@index([status])
  @@index([prospect_type])
  @@index([vendor_category])
  @@index([handle])
  @@map("prospects")
}

model DiscoveryRun {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source          ProspectSource
  query           String
  // Free-form classifier (e.g. "hashtag", "location", "search", "directory").
  query_type      String
  // Tunes per-source result limits + LLM query expansion. One of
  // "quick" | "standard" | "deep".
  depth           String             @default("standard")
  status          DiscoveryRunStatus @default(queued)
  prospects_found Int                @default(0)
  prospects_new   Int                @default(0)
  cost_usd        Decimal?           @db.Decimal(8, 4)
  error           String?
  raw_payload     Json?
  triggered_by    String             @db.Uuid
  prospects       Prospect[]
  created_at      DateTime           @default(now())
  started_at      DateTime?
  completed_at    DateTime?

  @@index([status])
  @@index([source])
  @@map("discovery_runs")
}

model OutreachTemplate {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  // "email" | "whatsapp" | "instagram"
  channel    String
  type       ProspectType
  category   VendorCategory?
  subject    String?
  body       String
  active     Boolean         @default(true)
  created_at DateTime        @default(now())
  updated_at DateTime        @updatedAt

  @@index([channel, type, active])
  @@map("outreach_templates")
}

// ----- Stripe webhook idempotency -----
//
// One row per processed Stripe `event.id`. We INSERT before running the
// handler; on duplicate the webhook returns 2xx without re-running side
// effects. Auto-cleaned by a periodic prune job rather than at write time
// to keep the hot path fast.
model StripeWebhookEvent {
  id           String    @id
  type         String
  received_at  DateTime  @default(now())
  processed_at DateTime?

  @@index([received_at])
  @@map("stripe_webhook_events")
}

// ----- Refund ledger -----
//
// One row per Stripe refund (full or partial). A `Payment` flips to
// `refunded` only when the cumulative refunded amount equals the original
// gross — until then we mark `partially_refunded` so the UI can show
// remaining balance. `created_by_user_id` is null for refunds that
// originated in the Stripe dashboard.
model PaymentRefund {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payment_id         String   @db.Uuid
  stripe_refund_id   String   @unique
  amount             Decimal  @db.Decimal(10, 2)
  currency           String   @default("EGP")
  reason             String?
  created_by_user_id String?  @db.Uuid
  created_at         DateTime @default(now())

  payment Payment @relation(fields: [payment_id], references: [id], onDelete: Cascade)

  @@index([payment_id])
  @@map("payment_refunds")
}

// ----- Notifications -----
//
// One row per delivered notification. In-app is the source of truth; email
// is a best-effort side effect driven by the notify() service. `data` holds
// structured metadata (e.g. { installmentId, eventId, amount }) used by
// dedupe logic on the cron + future filters without schema churn.
model Notification {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String           @db.Uuid
  type       NotificationType
  title      String
  body       String?
  link       String?
  data       Json             @default("{}")
  read_at    DateTime?
  emailed_at DateTime?
  created_at DateTime         @default(now())

  user Profile @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, read_at, created_at(sort: Desc)])
  @@index([user_id, created_at(sort: Desc)])
  @@index([type, created_at(sort: Desc)])
  @@map("notifications")
}

// ----- Wedding Vision Pack -----
//
// Paid entry product. A couple (or gifter) pays once for a packaged AI
// experience: mood board + N renders + N videos + a printable lookbook +
// a public microsite. The pack is the paywall in front of `ai.renderScene`
// and `ai.startVideo` — quota counters here are decremented atomically
// after each successful generation. When `event_id` is later set via the
// `findPlanner` flow the existing marketplace funnel takes over without
// any further changes.
//
// Gifting columns are stubbed in v1 (no UI yet); shipping the redemption
// flow later doesn't require a migration.
model VisionPack {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Buyer is who paid Stripe. Recipient is the couple who'll redeem and
  // use it. For self-purchase both equal the same Profile. For a gift,
  // buyer is the gifter and recipient is null until the gift is claimed.
  buyer_user_id     String  @db.Uuid
  recipient_user_id String? @db.Uuid

  status      VisionPackStatus @default(pending_payment)
  redeemed_at DateTime?
  // 60-day usage window from `redeemed_at` (or paid_at for self-purchase).
  expires_at  DateTime?

  // Gifting (no UI in v1; columns ship now to avoid a follow-up migration).
  is_gift              Boolean @default(false)
  gift_code            String? @unique
  gift_recipient_email String?
  gift_recipient_name  String?
  gift_message         String?

  // Stripe linkage (mirrors the shape on Payment).
  stripe_checkout_session_id String?  @unique
  stripe_payment_intent_id   String?
  amount                     Decimal  @db.Decimal(10, 2)
  currency                   String   @default("EGP")
  paid_at                    DateTime?

  // Quotas. Hard-coded defaults for v1; move to a `pack_skus` table when
  // we ship multiple tiers.
  renders_quota Int @default(20)
  renders_used  Int @default(0)
  videos_quota  Int @default(2)
  videos_used   Int @default(0)

  // Optional link to the Event the recipient creates from this pack via
  // `visionPacks.findPlanner`. Set when they want to match with a planner;
  // remains null otherwise (standalone pack, no marketplace handoff).
  event_id String? @db.Uuid

  // Public microsite slug. Generated at activation time, immutable
  // afterwards so links don't rot. URL is `/v/<slug>`.
  microsite_slug         String?   @unique
  microsite_published_at DateTime?
  // True if the recipient has opted into the public gallery feed. Default
  // false at the row level — recipients must opt-in explicitly via account
  // settings. Microsite still renders at the slug regardless.
  microsite_public       Boolean   @default(false)
  // First-download timestamp on the lookbook PDF. Used by the refund
  // tripwire — once the lookbook is downloaded refunds are off.
  lookbook_downloaded_at DateTime?

  refunded_at   DateTime?
  refund_reason String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  buyer     Profile  @relation("PackBuyer", fields: [buyer_user_id], references: [id], onDelete: Cascade)
  recipient Profile? @relation("PackRecipient", fields: [recipient_user_id], references: [id], onDelete: SetNull)
  event     Event?   @relation(fields: [event_id], references: [id], onDelete: SetNull)

  @@index([recipient_user_id, status])
  @@index([buyer_user_id, status])
  @@index([gift_code])
  @@index([microsite_published_at, microsite_public])
  @@map("vision_packs")
}

// Per-country price overrides for the Vision Pack. Read by the public
// marketing/paywall surface; written by admins via the dashboard. Lookup
// is country_code first, falling back to the seed table in
// `src/lib/vision-pack-pricing.ts`. The special `country_code = "DEFAULT"`
// row, when present, overrides the seed default.
model VisionPackPricing {
  country_code String   @id @db.VarChar(8)
  amount       Int
  currency     String   @db.Char(3)
  notes        String?
  updated_at   DateTime @updatedAt
  updated_by   String?  @db.Uuid

  @@map("vision_pack_pricing")
}

// Status lifecycle for an admin-generated social post.
//   pending   — fresh out of the generator, waiting for triage
//   published — admin marked it ready (manual posting happens off-platform)
//   discarded — rejected
enum PostStatus {
  pending
  published
  discarded
}

// Carousel format. Each format has its own slide order — see
// `src/lib/post-generator/formats.ts`.
enum PostFormat {
  inspo_to_render
  palette_test
  real_bride
  planner_pov
  three_words
}

// Admin-only generated Instagram/TikTok carousel posts. Renders, palette,
// inspiration board, and slide layout are produced by the post generator
// pipeline (`src/server/posts/`) and rasterized client-side via
// html-to-image when the admin clicks "Render to HD". Publishing is a
// status-flip only — actual posting to IG/TikTok is manual from a phone.
model Post {
  id     String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status PostStatus @default(pending)
  format PostFormat
  vibe   String

  // NamedPalette: { name: string, colors: { name: string, hex: string }[] }
  palette Json

  // CoupleNames: { partner_a: string, partner_b: string }
  couple_names Json

  // string[] of 6-8 mirrored Cloudinary URLs (we don't trust pinterest CDNs)
  inspiration_image_urls Json

  // string[] of 1-4 Cloudinary URLs depending on format
  render_image_urls Json

  // SlideRecord[] — see `src/types/posts.ts`
  slides Json

  caption  String @db.Text
  // Exactly 5 entries (1 broad / 1 vibe-specific / 1 community /
  // 1 cultural-when-applicable / 1 zaffa-adjacent). Stored as Json string[]
  // rather than Postgres array to keep the slot rule client-validatable.
  hashtags Json

  created_by   String    @db.Uuid
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @updatedAt @db.Timestamptz(6)
  published_at DateTime? @db.Timestamptz(6)

  @@index([status, created_at(sort: Desc)])
  @@map("posts")
}
