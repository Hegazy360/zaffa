generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector")]
}

enum UserRole {
  client
  planner
  vendor
  admin
}

enum EventType {
  wedding
  engagement
  birthday
  corporate
  other
}

enum EventStatus {
  draft
  planning
  confirmed
  in_progress
  completed
  cancelled
}

enum VendorCategory {
  catering
  photography
  videography
  flowers
  music
  decoration
  venue
  makeup
  fashion
  transportation
  other
}

enum BookingStatus {
  pending
  accepted
  declined
  completed
  cancelled
}

enum PaymentStatus {
  pending
  awaiting_payment
  processing
  paid
  failed
  refunded
  partially_refunded
  overdue
  cancelled
}

enum PaymentScheduleStatus {
  draft
  proposed
  active
  amended
  completed
  cancelled
}

enum AmendmentStatus {
  pending
  accepted
  rejected
  withdrawn
}

enum PayoutMethod {
  instapay
  wire
  cash
  other
}

enum PayoutRecipientType {
  planner
  vendor
}

enum VendorEngagementStatus {
  draft
  requested
  accepted
  declined
  active
  completed
  cancelled
}

enum VendorReleaseStatus {
  pending
  paid
  cancelled
}

enum ProposalStatus {
  pending
  accepted
  released
  declined
}

enum VisionPackStatus {
  pending_payment
  active
  fulfilled
  refunded
  expired
}

// Every user-facing notification is one of these. Grouped by the role most
// likely to receive it — but delivery is determined by the notify() call
// site, not the enum value.
enum NotificationType {
  // Client-facing
  proposal_received
  proposal_withdrawn
  planner_assigned
  payment_schedule_proposed
  payment_schedule_amendment_proposed
  payment_paid
  payment_failed
  payment_refunded
  payment_due_reminder
  payment_overdue
  // Planner-facing
  event_in_service_area
  proposal_accepted
  proposal_released
  schedule_amendment_decided
  payment_received
  payout_received
  vendor_accepted_engagement
  vendor_declined_engagement
  vendor_cancelled_engagement
  review_received
  payment_disputed
  // Vendor-facing
  engagement_requested
  engagement_cancelled
  engagement_items_updated
  // Shared (both parties of an event thread)
  message_received
  // Vision Pack lifecycle (couple-facing)
  vision_pack_ready
  // Ops/admin: couple clicked "I'm interested" on a recommended venue.
  // Fan-out target is whichever admins should action the introduction.
  venue_lead_opened
  // Ops/admin: a full-service enquiry landed. This is the flagship tier's
  // only inbound channel, so the fan-out is deliberately noisy.
  enquiry_received
  // Ops/admin: a couple approved their design — "I want this wedding,
  // contact me". The warmest lead the funnel produces; their render is
  // attached to the enquiry as the brief.
  design_approved
}

/// Sales pipeline for the full-service plan ("The Whole Wedding").
/// Forward-only except `lost`, which is reachable from any state.
enum EnquiryStatus {
  new
  contacted
  call_scheduled
  quote_sent
  accepted
  deposit_paid
  in_planning
  delivered
  lost
}

/// How the couple prefers to be reached. WhatsApp leads because it is the
/// dominant business channel across our launch markets.
enum EnquiryChannel {
  whatsapp
  email
  phone
}

model Profile {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  role                   UserRole  @default(client)
  full_name              String
  avatar_url             String?
  phone                  String?
  // Two-letter locale ("en", "ar"). Persisted server-side so the choice
  // follows the user across devices. Middleware seeds the cookie from
  // Accept-Language for anonymous visitors.
  locale                 String    @default("en")
  // Mirrors `auth.users.is_anonymous`. True for Supabase anonymous users
  // — first-touch venue-designer visitors who haven't entered an email
  // yet. Flipped to false by the `on_auth_user_upgraded` trigger when
  // the user confirms their email via `auth.requestEmailUpgrade`.
  is_anonymous           Boolean   @default(false)
  // Lowercased email used for the free render gate. Stored separately
  // from `auth.users.email` because we lock the free-render entitlement
  // to this address from the moment we send the magic link — even
  // before Supabase upgrades the user. Partial unique index in the
  // migration enforces one free render per email globally.
  free_render_email      String?
  // Set to a timestamp when the user clicks the unsubscribe link in any
  // transactional email. In-app notifications are unaffected; we just stop
  // emailing them for everything.
  email_unsubscribed_at  DateTime?
  // Soft-delete request timestamps. `deletion_requested_at` is set when
  // the user clicks "Delete account" in settings; `deletion_scheduled_for`
  // is the date a background job will hard-delete the row. Sign-in is
  // refused while either is set so the grace period still gives them an
  // unmistakable signal that their account is being wound down.
  deletion_requested_at  DateTime?
  deletion_scheduled_for DateTime?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  planner_profile       PlannerProfile?
  vendor_profile        VendorProfile?
  client_events         Event[]             @relation("ClientEvents")
  sent_messages         Message[]
  reviews               Review[]            @relation("AuthorReviews")
  vendor_reviews        VendorReview[]      @relation("AuthorVendorReviews")
  style_quiz_sessions   StyleQuizSession[]
  venue_designs         VenueDesign[]
  notifications         Notification[]
  enquiries             Enquiry[]           @relation("EnquiryContact")
  enquiry_notes         EnquiryNote[]
  bought_vision_packs   VisionPack[]        @relation("PackBuyer")
  received_vision_packs VisionPack[]        @relation("PackRecipient")
  email_capture_events  EmailCaptureEvent[]
  chat_conversations    ChatConversation[]

  @@index([is_anonymous, created_at])
  @@map("profiles")
}

model PlannerProfile {
  id              String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String                       @unique @db.Uuid
  business_name   String
  bio             String?
  location        String?
  specialties     Json                         @default("[]")
  // Structured service-area used by the "new event in your area" notification
  // fan-out. `service_cities` is a JSON array of lowercased city names; an
  // empty array disables area-based matching for this planner. Existing rows
  // default to empty + EG so we can roll the column out without a backfill.
  service_country String                       @default("EG")
  service_cities  Json                         @default("[]")
  avg_rating      Decimal                      @default(0) @db.Decimal(3, 2)
  review_count    Int                          @default(0)
  verified        Boolean                      @default(false)
  embedding       Unsupported("vector(1536)")?
  created_at      DateTime                     @default(now())
  updated_at      DateTime                     @updatedAt

  profile            Profile            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  events             Event[]            @relation("PlannerEvents")
  portfolio_items    PortfolioItem[]
  reviews            Review[]
  proposals          Proposal[]
  blocks             PlannerBlock[]
  payment_schedules  PaymentSchedule[]
  payouts            Payout[]
  vendor_engagements VendorEngagement[]
  vendor_releases    VendorRelease[]

  @@map("planner_profiles")
}

model VendorProfile {
  id            String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String                       @unique @db.Uuid
  business_name String
  category      VendorCategory
  location      String?
  bio           String?
  specialties   Json                         @default("[]")
  avg_rating    Decimal                      @default(0) @db.Decimal(3, 2)
  review_count  Int                          @default(0)
  verified      Boolean                      @default(false)
  embedding     Unsupported("vector(1536)")?
  created_at    DateTime                     @default(now())
  updated_at    DateTime                     @updatedAt

  profile         Profile               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  services        VendorService[]
  events          EventVendor[]
  portfolio_items VendorPortfolioItem[]
  reviews         VendorReview[]
  engagements     VendorEngagement[]
  releases        VendorRelease[]
  payouts         Payout[]

  @@map("vendor_profiles")
}

model VendorService {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendor_id      String   @db.Uuid
  name           String
  description    String?
  price_from     Decimal  @db.Decimal(10, 2)
  price_unit     String   @default("per_event")
  // Free-text refinement under the vendor's primary category
  // (e.g. "tea-light", "centerpiece"). Used in browse filters.
  subcategory    String?
  // Json array of Cloudinary URLs. Empty array = no images.
  images         Json     @default("[]")
  lead_time_days Int?
  // Soft-hide so vendors can pause an item without losing the row.
  available      Boolean  @default(true)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  vendor VendorProfile          @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  items  VendorEngagementItem[]

  @@index([vendor_id, available])
  @@map("vendor_services")
}

model VendorPortfolioItem {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  vendor_id  String     @db.Uuid
  image_url  String
  caption    String?
  event_type EventType?
  style_tags Json       @default("[]")
  created_at DateTime   @default(now())

  vendor VendorProfile @relation(fields: [vendor_id], references: [id], onDelete: Cascade)

  @@index([vendor_id])
  @@map("vendor_portfolio_items")
}

model VendorReview {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Author is the engaging planner (clients never see vendors). Stored as
  // Profile.id so we don't need a planner-only constraint at the DB layer.
  author_id     String   @db.Uuid
  vendor_id     String   @db.Uuid
  // Nullable so the same author can leave one review per (vendor, engagement)
  // and aggregate them at the vendor level.
  engagement_id String?  @db.Uuid
  rating        Int
  comment       String?
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now()) @updatedAt

  author     Profile           @relation("AuthorVendorReviews", fields: [author_id], references: [id], onDelete: Cascade)
  vendor     VendorProfile     @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  engagement VendorEngagement? @relation(fields: [engagement_id], references: [id], onDelete: SetNull)

  @@unique([author_id, vendor_id, engagement_id])
  @@index([vendor_id, rating])
  @@map("vendor_reviews")
}

model VendorEngagement {
  id           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id     String                 @db.Uuid
  planner_id   String                 @db.Uuid
  vendor_id    String                 @db.Uuid
  title        String
  notes        String?
  status       VendorEngagementStatus @default(requested)
  currency     String                 @default("EGP")
  // Recomputed from the line items on every mutation.
  total_amount Decimal                @db.Decimal(12, 2)
  requested_at DateTime?
  accepted_at  DateTime?
  completed_at DateTime?
  cancelled_at DateTime?
  created_at   DateTime               @default(now())
  updated_at   DateTime               @updatedAt

  event    Event                  @relation(fields: [event_id], references: [id], onDelete: Cascade)
  planner  PlannerProfile         @relation(fields: [planner_id], references: [id], onDelete: Cascade)
  vendor   VendorProfile          @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  items    VendorEngagementItem[]
  releases VendorRelease[]
  reviews  VendorReview[]

  @@index([event_id, status])
  @@index([planner_id, status])
  @@index([vendor_id, status])
  @@map("vendor_engagements")
}

model VendorEngagementItem {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  engagement_id String    @db.Uuid
  // Nullable when the item is a one-off custom row not in the vendor's catalog.
  service_id    String?   @db.Uuid
  name          String
  description   String?
  quantity      Int       @default(1)
  unit_price    Decimal   @db.Decimal(10, 2)
  line_total    Decimal   @db.Decimal(12, 2)
  delivered_at  DateTime?
  created_at    DateTime  @default(now())

  engagement VendorEngagement @relation(fields: [engagement_id], references: [id], onDelete: Cascade)
  service    VendorService?   @relation(fields: [service_id], references: [id], onDelete: SetNull)

  @@index([engagement_id])
  @@map("vendor_engagement_items")
}

model VendorRelease {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  engagement_id String              @db.Uuid
  planner_id    String              @db.Uuid
  vendor_id     String              @db.Uuid
  label         String
  amount        Decimal             @db.Decimal(12, 2)
  currency      String              @default("EGP")
  status        VendorReleaseStatus @default(pending)
  notes         String?
  requested_at  DateTime            @default(now())
  paid_at       DateTime?
  // Set when admin records the matching off-Stripe Payout.
  payout_id     String?             @db.Uuid

  engagement VendorEngagement @relation(fields: [engagement_id], references: [id], onDelete: Cascade)
  planner    PlannerProfile   @relation(fields: [planner_id], references: [id], onDelete: Cascade)
  vendor     VendorProfile    @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  payout     Payout?          @relation(fields: [payout_id], references: [id], onDelete: SetNull)

  @@index([planner_id, status])
  @@index([vendor_id, status])
  @@index([engagement_id])
  @@map("vendor_releases")
}

model Event {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id          String      @db.Uuid
  planner_id         String?     @db.Uuid
  title              String
  event_type         EventType
  event_date         DateTime?   @db.Date
  venue              String?
  budget             Decimal?    @db.Decimal(12, 2)
  status             EventStatus @default(draft)
  style_preferences  Json?
  ai_recommendations Json?
  created_at         DateTime    @default(now())
  updated_at         DateTime    @updatedAt

  client                Profile                    @relation("ClientEvents", fields: [client_id], references: [id], onDelete: Cascade)
  planner               PlannerProfile?            @relation("PlannerEvents", fields: [planner_id], references: [id])
  vendors               EventVendor[]
  messages              Message[]
  designs               VenueDesign[]
  payments              Payment[]
  proposals             Proposal[]
  reviews               Review[]
  payment_schedules     PaymentSchedule[]
  vendor_engagements    VendorEngagement[]
  vision_packs          VisionPack[]
  venue_recommendations EventVenueRecommendation[]
  enquiries             Enquiry[]

  // Hot path: the marketplace teaser counts/fetches "open briefs"
  // (planner_id IS NULL). Without this we seq-scan `events` on every
  // home-page render. Composite with status because the second teaser
  // count filters by status as well.
  @@index([planner_id, status])
  @@map("events")
}

model EventVendor {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id     String        @db.Uuid
  vendor_id    String        @db.Uuid
  status       BookingStatus @default(pending)
  agreed_price Decimal?      @db.Decimal(10, 2)
  created_at   DateTime      @default(now())

  event  Event         @relation(fields: [event_id], references: [id], onDelete: Cascade)
  vendor VendorProfile @relation(fields: [vendor_id], references: [id])

  @@unique([event_id, vendor_id])
  @@map("event_vendors")
}

model PortfolioItem {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planner_id String     @db.Uuid
  image_url  String
  caption    String?
  event_type EventType?
  style_tags Json       @default("[]")
  created_at DateTime   @default(now())

  planner PlannerProfile @relation(fields: [planner_id], references: [id], onDelete: Cascade)

  @@map("portfolio_items")
}

model Review {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  author_id  String   @db.Uuid
  planner_id String   @db.Uuid
  event_id   String?  @db.Uuid
  rating     Int
  comment    String?
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  author  Profile        @relation("AuthorReviews", fields: [author_id], references: [id], onDelete: Cascade)
  planner PlannerProfile @relation(fields: [planner_id], references: [id], onDelete: Cascade)
  event   Event?         @relation(fields: [event_id], references: [id], onDelete: SetNull)

  // One review per (client, planner, event) so a couple can update their
  // existing review rather than stacking new rows after re-engagements.
  @@unique([author_id, planner_id, event_id])
  @@map("reviews")
}

model Message {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id   String   @db.Uuid
  sender_id  String   @db.Uuid
  content    String
  created_at DateTime @default(now())

  event  Event   @relation(fields: [event_id], references: [id], onDelete: Cascade)
  sender Profile @relation(fields: [sender_id], references: [id], onDelete: Cascade)

  @@map("messages")
}

enum InspirationCategory {
  overall_vibe
  flowers
  tables
  lighting
  venue_decor
}

model InspirationImage {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category      InspirationCategory
  subcategory   String
  image_url     String
  thumbnail_url String
  alt_text      String
  tags          Json                @default("[]")
  source        String              @default("unsplash")
  source_id     String?
  photographer  String?
  created_at    DateTime            @default(now())

  @@index([category, subcategory])
  @@map("inspiration_images")
}

model StyleQuizSession {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String   @db.Uuid
  answers      Json     @default("{}")
  ai_advice    Json     @default("{}")
  final_result Json?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  user Profile @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("style_quiz_sessions")
}

model VenueDesign {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.Uuid
  event_id    String?   @db.Uuid
  name        String    @default("Untitled Design")
  event_type  String    @default("wedding")
  setting     String    @default("indoor")
  // Coarse size bucket (intimate / medium / large) — kept for the AI scene
  // generator's layout descriptor. Derived on save from `guest_count` when
  // a precise count is provided; otherwise selected directly.
  size        String    @default("medium")
  // Exact expected guest count entered by the couple. Optional because
  // older designs were captured before this field existed.
  guest_count Int?
  palette     Json      @default("{}")
  references  Json      @default("{}")
  style_notes String?
  thumbnail   String?
  approved_at DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  user      Profile            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  event     Event?             @relation(fields: [event_id], references: [id], onDelete: SetNull)
  media     VenueDesignMedia[]
  enquiries Enquiry[]

  // Marketplace teaser joins event → designs and filters approved_at IS
  // NOT NULL. Composite (event_id, approved_at) supersedes the bare
  // event_id index for the EXISTS subquery in the teaser count and is
  // still usable for any lookup that filters on event_id alone.
  @@index([event_id, approved_at])
  @@map("venue_designs")
}

model VenueDesignMedia {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  design_id            String   @db.Uuid
  // For videos: id of the render (also a VenueDesignMedia row) the video was
  // generated from. NULL for renders themselves and for legacy videos from
  // before this column existed.
  parent_id            String?  @db.Uuid
  type                 String
  // CDN URL of the clean (un-watermarked) asset. For free-tier renders
  // the list/getById endpoints rewrite this on read into the signed
  // watermarked URL derived from `cloudinary_public_id` (see
  // `watermarkedUrl` in `src/lib/cloudinary.ts`).
  url                  String
  // Cloudinary `public_id` for media uploaded through our pipeline.
  // Nullable for legacy rows + provider URLs that bypass Cloudinary.
  // Required to derive the watermarked transformation URL on the fly.
  cloudinary_public_id String?
  created_at           DateTime @default(now())

  design               VenueDesign         @relation(fields: [design_id], references: [id], onDelete: Cascade)
  parent               VenueDesignMedia?   @relation("MediaParent", fields: [parent_id], references: [id], onDelete: SetNull)
  children             VenueDesignMedia[]  @relation("MediaParent")
  email_capture_events EmailCaptureEvent[]

  @@map("venue_design_media")
}

model Payment {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id    String        @db.Uuid
  // Nullable so legacy manual ledger rows still load. New rows created from
  // a PaymentSchedule always reference a schedule.
  schedule_id String?       @db.Uuid
  label       String
  amount      Decimal       @db.Decimal(10, 2)
  currency    String        @default("EGP")
  status      PaymentStatus @default(pending)
  due_date    DateTime?
  paid_at     DateTime?
  notes       String?

  // Stripe linkage. All nullable until the client opens a Checkout session.
  /// Concierge installments are collected via Stripe Payment Links, not
  /// Checkout Sessions: a Session expires in 24h, which is wrong for a link
  /// sent over WhatsApp and opened days later. A Payment Link is persistent
  /// and can be restricted to a single completion. Null on planner
  /// installments, which keep using Checkout.
  stripe_payment_link_id     String?
  payment_link_url           String?
  stripe_checkout_session_id String?
  stripe_payment_intent_id   String?
  stripe_charge_id           String?
  stripe_refund_id           String?

  // Cached at capture time so we don't recompute on every read and so the
  // amounts are stable even if the schedule's fee_pct changes later.
  platform_fee_amount   Decimal? @db.Decimal(10, 2)
  net_to_planner_amount Decimal? @db.Decimal(10, 2)

  // Cumulative amount refunded across all `PaymentRefund` rows for this
  // installment. Maintained by the refund flow; lets us tell partial vs
  // full refunds without scanning the ledger on every read.
  refunded_amount Decimal @default(0) @db.Decimal(10, 2)

  // Set when an admin records a Payout that includes this installment.
  payout_id String? @db.Uuid

  // Dispute lifecycle.
  // - `disputed_at`: set on charge.dispute.created
  // - `dispute_status`: latest known status from Stripe
  //   (warning_needs_response / under_review / won / lost / charge_refunded)
  // - `dispute_resolved_at`: set when dispute closes (won/lost)
  disputed_at         DateTime?
  dispute_status      String?
  dispute_resolved_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  event    Event            @relation(fields: [event_id], references: [id], onDelete: Cascade)
  schedule PaymentSchedule? @relation(fields: [schedule_id], references: [id], onDelete: SetNull)
  payout   Payout?          @relation(fields: [payout_id], references: [id], onDelete: SetNull)
  refunds  PaymentRefund[]

  @@index([event_id])
  @@index([schedule_id])
  @@index([payout_id])
  @@map("payments")
}

model PaymentSchedule {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id         String                @db.Uuid
  proposal_id      String                @db.Uuid
  planner_id       String                @db.Uuid
  client_id        String                @db.Uuid
  currency         String                @default("EGP")
  total_amount     Decimal               @db.Decimal(12, 2)
  platform_fee_pct Decimal               @default(8.0) @db.Decimal(5, 2)
  status           PaymentScheduleStatus @default(draft)
  accepted_at      DateTime?
  cancelled_at     DateTime?
  created_at       DateTime              @default(now())
  updated_at       DateTime              @updatedAt

  event        Event               @relation(fields: [event_id], references: [id], onDelete: Cascade)
  proposal     Proposal            @relation(fields: [proposal_id], references: [id], onDelete: Cascade)
  planner      PlannerProfile      @relation(fields: [planner_id], references: [id], onDelete: Cascade)
  installments Payment[]
  amendments   ScheduleAmendment[]

  @@index([event_id])
  @@index([planner_id])
  @@index([proposal_id])
  @@map("payment_schedules")
}

model ScheduleAmendment {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schedule_id           String          @db.Uuid
  requested_by_user_id  String          @db.Uuid
  // Snapshot of the proposed not-yet-paid installments. Shape:
  // [{ label: string, amount: number, due_date: string | null }]
  proposed_installments Json
  proposed_total        Decimal         @db.Decimal(12, 2)
  proposed_fee_pct      Decimal?        @db.Decimal(5, 2)
  reason                String?
  status                AmendmentStatus @default(pending)
  decided_at            DateTime?
  decided_by_user_id    String?         @db.Uuid
  created_at            DateTime        @default(now())
  updated_at            DateTime        @updatedAt

  schedule PaymentSchedule @relation(fields: [schedule_id], references: [id], onDelete: Cascade)

  @@index([schedule_id, status])
  @@map("schedule_amendments")
}

model Payout {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Either planner_id or vendor_id must be set depending on recipient_type.
  // We keep planner_id nullable now to support vendor-recipient payouts; the
  // tRPC layer enforces the "exactly one is set" invariant.
  planner_id          String?             @db.Uuid
  vendor_id           String?             @db.Uuid
  recipient_type      PayoutRecipientType @default(planner)
  currency            String              @default("EGP")
  amount              Decimal             @db.Decimal(12, 2)
  method              PayoutMethod        @default(instapay)
  reference           String?
  notes               String?
  paid_at             DateTime
  recorded_by_user_id String              @db.Uuid
  created_at          DateTime            @default(now())

  planner         PlannerProfile? @relation(fields: [planner_id], references: [id], onDelete: Cascade)
  vendor          VendorProfile?  @relation(fields: [vendor_id], references: [id], onDelete: Cascade)
  installments    Payment[]
  vendor_releases VendorRelease[]

  @@index([planner_id, paid_at])
  @@index([vendor_id, paid_at])
  @@map("payouts")
}

model Proposal {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id        String         @db.Uuid
  planner_id      String         @db.Uuid
  cover_letter    String
  quote_amount    Decimal?       @db.Decimal(12, 2)
  quote_currency  String         @default("EGP")
  quote_breakdown Json?
  status          ProposalStatus @default(pending)
  accepted_at     DateTime?
  released_at     DateTime?
  release_reason  String?
  release_rating  Int?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  event             Event             @relation(fields: [event_id], references: [id], onDelete: Cascade)
  planner           PlannerProfile    @relation(fields: [planner_id], references: [id], onDelete: Cascade)
  payment_schedules PaymentSchedule[]

  @@unique([event_id, planner_id])
  @@index([planner_id, status])
  @@index([event_id, status])
  @@map("proposals")
}

model PlannerBlock {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planner_id String   @db.Uuid
  start_date DateTime @db.Date
  end_date   DateTime @db.Date
  reason     String?
  created_at DateTime @default(now())

  planner PlannerProfile @relation(fields: [planner_id], references: [id], onDelete: Cascade)

  @@index([planner_id, start_date])
  @@map("planner_blocks")
}

// ----- Prospecting pipeline -----
//
// We treat planners and vendors that *don't have an account yet* as
// Prospects. Discovery jobs ingest them from public sources; an admin can
// also enter them manually. Outreach is fully manual — we draft the
// message, the admin copies + sends it.

enum ProspectSource {
  instagram
  tiktok
  facebook
  directory
  web
  manual
}

enum ProspectType {
  planner
  vendor
  unknown
}

enum ProspectStatus {
  new
  qualified
  drafted
  contacted
  replied
  signed_up
  rejected
}

enum DiscoveryRunStatus {
  queued
  running
  completed
  failed
}

model Prospect {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source            ProspectSource
  // ID assigned by the source (e.g. IG user id, FB page id). Combined with
  // `source` it gives us a stable cross-run identity for upserts.
  source_id         String?
  source_url        String?
  display_name      String
  // Public handle (IG/TikTok username, FB page slug, etc.).
  handle            String?
  prospect_type     ProspectType    @default(unknown)
  vendor_category   VendorCategory?
  email             String?
  whatsapp          String?
  phone             String?
  instagram         String?
  facebook          String?
  tiktok            String?
  website           String?
  bio               String?
  city              String?
  country           String?         @default("EG")
  followers         Int?
  avatar_url        String?
  // Cloudinary / source URLs of representative work.
  sample_images     Json            @default("[]")
  status            ProspectStatus  @default(new)
  // 0–100 LLM-assigned signal-quality score (higher = better fit).
  qualifying_score  Int?
  notes             String?
  draft_email       String?
  draft_whatsapp    String?
  draft_instagram   String?
  contacted_at      DateTime?
  contacted_via     String?
  replied_at        DateTime?
  // Filled by the signup matcher when this prospect creates an account.
  signed_up_user_id String?         @unique @db.Uuid
  // Verbatim payload from the source row for forensics/debugging.
  raw_payload       Json?
  discovery_run_id  String?         @db.Uuid
  created_at        DateTime        @default(now())
  updated_at        DateTime        @updatedAt
  last_seen_at      DateTime?

  discovery_run DiscoveryRun? @relation(fields: [discovery_run_id], references: [id], onDelete: SetNull)

  @@unique([source, source_id])
  @@index([status])
  @@index([prospect_type])
  @@index([vendor_category])
  @@index([handle])
  @@map("prospects")
}

model DiscoveryRun {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source          ProspectSource
  query           String
  // Free-form classifier (e.g. "hashtag", "location", "search", "directory").
  query_type      String
  // Tunes per-source result limits + LLM query expansion. One of
  // "quick" | "standard" | "deep".
  depth           String             @default("standard")
  status          DiscoveryRunStatus @default(queued)
  prospects_found Int                @default(0)
  prospects_new   Int                @default(0)
  cost_usd        Decimal?           @db.Decimal(8, 4)
  error           String?
  raw_payload     Json?
  triggered_by    String             @db.Uuid
  prospects       Prospect[]
  created_at      DateTime           @default(now())
  started_at      DateTime?
  completed_at    DateTime?

  @@index([status])
  @@index([source])
  @@map("discovery_runs")
}

model OutreachTemplate {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  // "email" | "whatsapp" | "instagram"
  channel    String
  type       ProspectType
  category   VendorCategory?
  subject    String?
  body       String
  active     Boolean         @default(true)
  created_at DateTime        @default(now())
  updated_at DateTime        @updatedAt

  @@index([channel, type, active])
  @@map("outreach_templates")
}

// ----- Stripe webhook idempotency -----
//
// One row per processed Stripe `event.id`. We INSERT before running the
// handler; on duplicate the webhook returns 2xx without re-running side
// effects. Auto-cleaned by a periodic prune job rather than at write time
// to keep the hot path fast.
model StripeWebhookEvent {
  id           String    @id
  type         String
  received_at  DateTime  @default(now())
  processed_at DateTime?

  @@index([received_at])
  @@map("stripe_webhook_events")
}

// ----- Refund ledger -----
//
// One row per Stripe refund (full or partial). A `Payment` flips to
// `refunded` only when the cumulative refunded amount equals the original
// gross — until then we mark `partially_refunded` so the UI can show
// remaining balance. `created_by_user_id` is null for refunds that
// originated in the Stripe dashboard.
model PaymentRefund {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  payment_id         String   @db.Uuid
  stripe_refund_id   String   @unique
  amount             Decimal  @db.Decimal(10, 2)
  currency           String   @default("EGP")
  reason             String?
  created_by_user_id String?  @db.Uuid
  created_at         DateTime @default(now())

  payment Payment @relation(fields: [payment_id], references: [id], onDelete: Cascade)

  @@index([payment_id])
  @@map("payment_refunds")
}

// ----- Notifications -----
//
// One row per delivered notification. In-app is the source of truth; email
// is a best-effort side effect driven by the notify() service. `data` holds
// structured metadata (e.g. { installmentId, eventId, amount }) used by
// dedupe logic on the cron + future filters without schema churn.
model Notification {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String           @db.Uuid
  type       NotificationType
  title      String
  body       String?
  link       String?
  data       Json             @default("{}")
  read_at    DateTime?
  emailed_at DateTime?
  created_at DateTime         @default(now())

  user Profile @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, read_at, created_at(sort: Desc)])
  @@index([user_id, created_at(sort: Desc)])
  @@index([type, created_at(sort: Desc)])
  @@map("notifications")
}

// ----- Wedding Vision Pack -----
//
// Paid entry product. A couple (or gifter) pays once for a packaged AI
// experience: mood board + N renders + N videos + a printable lookbook +
// a public microsite. The pack is the paywall in front of `ai.renderScene`
// and `ai.startVideo` — quota counters here are decremented atomically
// after each successful generation. When `event_id` is later set via the
// `findPlanner` flow the existing marketplace funnel takes over without
// any further changes.
//
// Two SKUs ship today (see `PACK_SKUS` in `src/lib/vision-pack.ts`):
//   * `wedding_design_pack_v1` — design + microsite + PDF, no matching
//   * `wedding_vision_pack_v1` — full pack + planner/venue matching
// Quotas, capability flags, and the "find a planner / show venue recs"
// gates are all derived from the SKU registry; the row stamps the SKU at
// checkout time so an individual purchase keeps its tier even if the
// registry changes later.
//
// Gifting columns are stubbed in v1 (no UI yet); shipping the redemption
// flow later doesn't require a migration.
model VisionPack {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // SKU id from `PACK_SKUS`. Defaults to the full Vision Pack so legacy
  // rows backfilled by the migration land on the right tier.
  sku String @default("wedding_vision_pack_v1")

  // Buyer is who paid Stripe. Recipient is the couple who'll redeem and
  // use it. For self-purchase both equal the same Profile. For a gift,
  // buyer is the gifter and recipient is null until the gift is claimed.
  buyer_user_id     String  @db.Uuid
  recipient_user_id String? @db.Uuid

  status      VisionPackStatus @default(pending_payment)
  redeemed_at DateTime?        @db.Timestamptz(6)
  // 60-day usage window from `redeemed_at` (or paid_at for self-purchase).
  expires_at  DateTime?        @db.Timestamptz(6)

  // Gifting (no UI in v1; columns ship now to avoid a follow-up migration).
  is_gift              Boolean @default(false)
  gift_code            String? @unique
  gift_recipient_email String?
  gift_recipient_name  String?
  gift_message         String?

  // Stripe linkage (mirrors the shape on Payment). `amount` is stored in
  // **minor units** (e.g. 1999 for $19.99, 49900 for 499 EGP) so we can
  // express fractional retail prices without a Decimal column. Display
  // helpers in `src/lib/vision-pack-pricing.ts` divide by 100 (or use
  // zero-decimal currencies as-is) when formatting.
  //
  // The free email-gated tier (`wedding_free_taste_v1`) is stored with
  // `amount = 0`. Refund eligibility (`isPackRefundable`) short-circuits
  // on amount === 0 so the free tier is never refundable.
  stripe_checkout_session_id String?   @unique
  stripe_payment_intent_id   String?
  amount                     Int
  currency                   String    @default("EGP")
  paid_at                    DateTime? @db.Timestamptz(6)
  // 2-letter ISO country resolved from the geo cookie/header at
  // checkout time. Stamped immutably so the delta-priced upgrade flow
  // can resolve the destination tier price in the same market the
  // original purchase used. Null on legacy rows + the free tier.
  purchase_country           String?   @db.VarChar(8)

  // Quotas. Stamped from the SKU registry at checkout time so an
  // individual pack keeps its quotas even if the SKU defaults change.
  renders_quota Int @default(20)
  renders_used  Int @default(0)
  videos_quota  Int @default(2)
  videos_used   Int @default(0)

  // Optional link to the Event the recipient creates from this pack via
  // `visionPacks.findPlanner`. Set when they want to match with a planner;
  // remains null otherwise (standalone pack, no marketplace handoff).
  event_id String? @db.Uuid

  // Public microsite slug. Generated at activation time, immutable
  // afterwards so links don't rot. URL is `/v/<slug>`.
  microsite_slug         String?   @unique
  microsite_published_at DateTime? @db.Timestamptz(6)
  // True if the recipient has opted into the public gallery feed. Default
  // false at the row level — recipients must opt-in explicitly via account
  // settings. Microsite still renders at the slug regardless.
  microsite_public       Boolean   @default(false)
  // First-download timestamp on the lookbook PDF. Used by the refund
  // tripwire — once the lookbook is downloaded refunds are off.
  lookbook_downloaded_at DateTime? @db.Timestamptz(6)

  refunded_at   DateTime? @db.Timestamptz(6)
  refund_reason String?

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  buyer     Profile             @relation("PackBuyer", fields: [buyer_user_id], references: [id], onDelete: Cascade)
  recipient Profile?            @relation("PackRecipient", fields: [recipient_user_id], references: [id], onDelete: SetNull)
  event     Event?              @relation(fields: [event_id], references: [id], onDelete: SetNull)
  upgrades  VisionPackUpgrade[]

  @@index([recipient_user_id, status])
  @@index([buyer_user_id, status])
  @@index([gift_code])
  @@index([microsite_published_at, microsite_public])
  @@map("vision_packs")
}

// ----- Vision Pack tier upgrades (Design Pack → Vision Pack) -----
//
// A user on the entry-tier Design Pack ($19) can pay the price
// difference to upgrade to the full Vision Pack ($99). One row per
// upgrade attempt; the `pack_id`'s `sku` flips to `to_sku` on webhook
// success. Keeping the audit trail separate from the pack row gives us
// a clean ledger for refunds, customer support, and reporting.
//
// Always charged in the pack's original currency (`vision_packs.currency`)
// using the destination tier's price for the pack's `purchase_country` —
// never the visitor's current geo. This stays consistent with the
// original purchase regardless of where the user later moves.
model VisionPackUpgrade {
  id                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pack_id                    String    @db.Uuid
  from_sku                   String
  to_sku                     String
  // Minor units in `currency` — e.g. 8001 = $80.01 for an upgrade from
  // $19 → $99. Always >= 0; zero means a free upgrade (admin grant).
  amount_charged             Int
  currency                   String    @db.Char(3)
  stripe_checkout_session_id String?   @unique
  stripe_payment_intent_id   String?
  // pending_payment | active | failed
  status                     String    @default("pending_payment")
  paid_at                    DateTime?
  created_at                 DateTime  @default(now())

  pack VisionPack @relation(fields: [pack_id], references: [id], onDelete: Cascade)

  @@index([pack_id, created_at(sort: Desc)])
  @@map("vision_pack_upgrades")
}

// ----- Email capture events -----
//
// One row per email-gate submission. Captures the original anonymous
// user id even after the upgrade flow runs (so we can stitch together
// the visit → render → email → upgrade funnel in analytics). Also
// drives the reconciliation cron that retries pushes to Resend
// Audiences for captures that failed first time.
model EmailCaptureEvent {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  anon_user_id     String    @db.Uuid
  email            String
  ip               String?
  country          String?
  design_id        String?   @db.Uuid
  render_id        String?   @db.Uuid
  // pending | sent | confirmed | failed
  status           String    @default("pending")
  resend_synced_at DateTime?
  created_at       DateTime  @default(now())

  anon_user Profile           @relation(fields: [anon_user_id], references: [id], onDelete: Cascade)
  render    VenueDesignMedia? @relation(fields: [render_id], references: [id], onDelete: SetNull)

  @@index([anon_user_id, created_at(sort: Desc)])
  @@index([status, created_at])
  @@map("email_capture_events")
}

// Per-country price overrides for each Vision Pack SKU. Read by the
// public marketing/paywall surface; written by admins via the dashboard.
// Lookup is `(sku, country_code)` first, then `(sku, "DEFAULT")`,
// falling back to the seed table in `src/lib/vision-pack-pricing.ts`.
//
// `amount` is stored in **minor units** (cents/piastres) — a $19.99
// override is `1999`. Zero-decimal currencies (JPY, KRW, …) use the
// raw figure. The display helpers in `src/lib/vision-pack-pricing.ts`
// handle the divide-by-100 / passthrough.
model VisionPackPricing {
  sku          String   @default("wedding_vision_pack_v1")
  country_code String   @db.VarChar(8)
  amount       Int
  currency     String   @db.Char(3)
  notes        String?
  updated_at   DateTime @updatedAt
  updated_by   String?  @db.Uuid

  @@id([sku, country_code])
  @@index([country_code])
  @@map("vision_pack_pricing")
}

// ----- Venue directory -----
//
// Admin-curated list of partner venues that Zaffa can recommend to
// couples on the higher-tier Vision Pack. `user_id` is intentionally
// nullable: v1 has no venue self-serve flow, but the column lets us
// link a Profile later when we invite venues to manage their own
// listings without a follow-up migration.
//
// Recommendations are scoped per-event via `EventVenueRecommendation`.
// The couple sees them on their event page; their "I'm interested"
// click sets `interested_at` and pings ops to facilitate the intro.
model Venue {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String?  @unique @db.Uuid
  name          String
  slug          String   @unique
  description   String?
  country       String
  city          String
  address       String?
  capacity_min  Int?
  capacity_max  Int?
  price_tier    String?
  styles        Json     @default("[]")
  amenities     Json     @default("[]")
  contact_name  String?
  contact_email String?
  contact_phone String?
  website       String?
  cover_image   String?
  published     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  images          VenueImage[]
  recommendations EventVenueRecommendation[]

  @@index([country, city, published])
  @@map("venues")
}

model VenueImage {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  venue_id String  @db.Uuid
  url      String
  alt      String?
  position Int     @default(0)

  venue Venue @relation(fields: [venue_id], references: [id], onDelete: Cascade)

  @@index([venue_id, position])
  @@map("venue_images")
}

model EventVenueRecommendation {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id      String    @db.Uuid
  venue_id      String    @db.Uuid
  // Zaffa's note to the couple about why this venue fits.
  note          String?
  position      Int       @default(0)
  // Profile.id of the admin who curated the recommendation.
  created_by    String    @db.Uuid
  created_at    DateTime  @default(now())
  // Couple action surface — both timestamps stay null until the user
  // explicitly engages with the card.
  interested_at DateTime?
  dismissed_at  DateTime?

  event Event @relation(fields: [event_id], references: [id], onDelete: Cascade)
  venue Venue @relation(fields: [venue_id], references: [id], onDelete: Cascade)

  @@unique([event_id, venue_id])
  @@index([event_id])
  @@map("event_venue_recommendations")
}

// Status lifecycle for an admin-generated social post.
//   pending   — fresh out of the generator, waiting for triage
//   published — admin marked it ready (manual posting happens off-platform)
//   discarded — rejected
enum PostStatus {
  pending
  published
  discarded
}

// Carousel format. Each format has its own slide order — see
// `src/lib/post-generator/formats.ts`.
enum PostFormat {
  inspo_to_render
  palette_test
  real_bride
  planner_pov
  three_words
}

// Admin-only generated Instagram/TikTok carousel posts. Renders, palette,
// inspiration board, and slide layout are produced by the post generator
// pipeline (`src/server/posts/`) and rasterized client-side via
// html-to-image when the admin clicks "Render to HD". Publishing is a
// status-flip only — actual posting to IG/TikTok is manual from a phone.
model Post {
  id     String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status PostStatus @default(pending)
  format PostFormat
  vibe   String

  // NamedPalette: { name: string, colors: { name: string, hex: string }[] }
  palette Json

  // CoupleNames: { partner_a: string, partner_b: string }
  couple_names Json

  // string[] of 6-8 mirrored Cloudinary URLs (we don't trust pinterest CDNs)
  inspiration_image_urls Json

  // string[] of 1-4 Cloudinary URLs depending on format
  render_image_urls Json

  // SlideRecord[] — see `src/types/posts.ts`
  slides Json

  caption  String @db.Text
  // Exactly 5 entries (1 broad / 1 vibe-specific / 1 community /
  // 1 cultural-when-applicable / 1 zaffa-adjacent). Stored as Json string[]
  // rather than Postgres array to keep the slot rule client-validatable.
  hashtags Json

  created_by   String    @db.Uuid
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @updatedAt @db.Timestamptz(6)
  published_at DateTime? @db.Timestamptz(6)

  @@index([status, created_at(sort: Desc)])
  @@map("posts")
}

/// A full-service enquiry — the only inbound channel for "The Whole Wedding".
///
/// Persistence is the whole point of this model. Before it existed, an
/// enquiry for the flagship tier was a single Resend email that silently
/// vanished if the API key was absent, so the sales pipeline lived in one
/// shared mailbox. The row is now written first and every side effect
/// (admin fan-out, acknowledgement email, analytics) is best-effort after it.
///
/// `user_id` is nullable on purpose: the wizard is open to anonymous
/// visitors, and the middleware only mints a Supabase user on the designer
/// and dashboard routes. A cold visitor from the homepage submits with
/// contact details alone.
model Enquiry {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status            EnquiryStatus @default(new)
  status_changed_at DateTime      @default(now()) @db.Timestamptz(6)

  /// Set when the submitter had a session (anonymous or permanent). Kept on
  /// SetNull so reaping anonymous users never destroys a lead.
  user_id String?  @db.Uuid
  user    Profile? @relation("EnquiryContact", fields: [user_id], references: [id], onDelete: SetNull)

  full_name         String
  email             String?
  /// E.164. At least one of email/phone is enforced in the router rather
  /// than the database, so the constraint can carry a translated message.
  phone             String?
  preferred_channel EnquiryChannel @default(whatsapp)

  /// ISO-3166-1 alpha-2, prefilled from the same `zaffa_country` cookie that
  /// drives per-country pricing. Never restricted to a list — an enquiry from
  /// an unpriced market is quoted bespoke, never refused.
  country         String?   @db.VarChar(2)
  city            String?
  event_date      DateTime? @db.Date
  date_flexible   Boolean   @default(false)
  /// Matches the buckets in `sizeFromGuestCount` so the wizard and the
  /// designer speak the same language.
  guest_band      String?
  budget_band     String?
  budget_currency String?   @db.Char(3)
  message         String?

  /// The design they enquired from — their AI render IS the brief. The
  /// admin sees their other designs via `user_id`, so no join table.
  design_id String?      @db.Uuid
  design    VenueDesign? @relation(fields: [design_id], references: [id], onDelete: SetNull)
  /// Set on conversion, linking the lead to the event we then run.
  event_id  String?      @db.Uuid
  event     Event?       @relation(fields: [event_id], references: [id], onDelete: SetNull)

  /// Which surface produced it: whole_wedding_home | render_page | contact | admin
  source String  @default("whole_wedding_home")
  locale String? @db.VarChar(5)

  /// Written when an admin prepares the quote. Decimal majors, matching
  /// `Payment.amount` rather than the minor-unit convention VisionPack uses.
  quoted_amount   Decimal? @db.Decimal(12, 2)
  quoted_currency String?  @db.Char(3)

  /// Whether the site was publishing our fee when this enquiry was submitted.
  ///
  /// `/enquire` and the published `/pricing` table went live within days of
  /// each other, so a with-price / without-price comparison can never be
  /// reconstructed from deploy dates afterwards. Stamping the cohort on the
  /// row is the only thing that keeps that question answerable. Nullable
  /// because rows written before ZAF-48 genuinely do not know.
  pricing_published Boolean?

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  notes EnquiryNote[]

  /// The admin inbox is a status-filtered, newest-first list; this index is
  /// exactly that query.
  @@index([status, created_at(sort: Desc)])
  @@index([user_id])
  @@map("enquiries")
}

/// Free-text operator notes on an enquiry — the CRM's memory between calls.
model EnquiryNote {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  enquiry_id String   @db.Uuid
  enquiry    Enquiry  @relation(fields: [enquiry_id], references: [id], onDelete: Cascade)
  author_id  String   @db.Uuid
  author     Profile  @relation(fields: [author_id], references: [id], onDelete: Cascade)
  body       String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([enquiry_id, created_at(sort: Desc)])
  @@map("enquiry_notes")
}

/// One visitor conversation with the homepage AI chat. Anonymous by
/// default (`user_id` null); linked when a signed-in user chats. Kept 90
/// days (cleanup cron) as the tuning corpus for the grounding prompt and
/// the abuse-forensics trail; account hard-deletion erases them.
model ChatConversation {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String?  @db.Uuid
  user            Profile? @relation(fields: [user_id], references: [id], onDelete: SetNull)
  locale          String?  @db.VarChar(5)
  country         String?  @db.VarChar(2)
  message_count   Int      @default(0)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  last_message_at DateTime @default(now()) @db.Timestamptz(6)

  messages ChatMessage[]

  @@index([last_message_at])
  @@index([user_id])
  @@map("chat_conversations")
}

/// One turn in a chat conversation. The user message is written BEFORE
/// the LLM call — a model failure still leaves the question on record.
model ChatMessage {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String           @db.Uuid
  conversation    ChatConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  role            String
  content         String
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@index([conversation_id, created_at])
  @@map("chat_messages")
}
