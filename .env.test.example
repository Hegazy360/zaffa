# -----------------------------------------------------------------------------
# Zaffa E2E test environment
# Copy to `.env.test` before running `npm run test:e2e`. Never commit `.env.test`
# (it contains live Stripe test-mode keys and a local DB password).
# -----------------------------------------------------------------------------

NODE_ENV=test

# --- Local Postgres (Docker) ------------------------------------------------
# Spin up with:
#   docker run --name zaffa-test-pg -e POSTGRES_PASSWORD=zaffa -p 54329:5432 \
#     -d ankane/pgvector:latest
# Use a non-standard port so it doesn't clash with your dev DB.
DATABASE_URL=postgresql://postgres:zaffa@localhost:54329/postgres
DIRECT_DATABASE_URL=postgresql://postgres:zaffa@localhost:54329/postgres

# --- Supabase (local stack) -------------------------------------------------
# Run `supabase start` to get these from the CLI's output.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me-with-supabase-start-output
SUPABASE_SERVICE_ROLE_KEY=replace-me-with-supabase-start-output

# --- Stripe (test mode) -----------------------------------------------------
# Get these from https://dashboard.stripe.com/test/apikeys.
STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Run `stripe listen --forward-to localhost:3100/api/webhooks/stripe` and copy
# the printed `whsec_...` here so signature verification passes.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# --- Payments ---------------------------------------------------------------
PLATFORM_FEE_PCT=8
PLATFORM_NAME=Zaffa
PAYMENT_SUCCESS_URL_BASE=http://localhost:3100

# --- Required production guards (env-checks.ts) -----------------------------
# These have to be present even in NODE_ENV=test for code that calls
# assertProductionEnv() in shared paths.
CRON_SECRET=test-cron-secret
NOTIFICATION_UNSUBSCRIBE_SECRET=test-unsubscribe-secret-min-16-chars

# --- Notification email (Resend) -------------------------------------------
# Leave RESEND_API_KEY blank — the email service is a no-op without it,
# which is exactly what the E2E suite wants (no real mail).
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL="Zaffa Test <noreply@zaffa.test>"
NEXT_PUBLIC_APP_URL=http://localhost:3100

# --- Upstash Redis ---------------------------------------------------------
# Optional in tests; rate-limit code falls back gracefully when unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Playwright ------------------------------------------------------------
E2E_PORT=3100
# Per-role test accounts. Pre-create these in Supabase auth via
# `npm run db:seed` (or the dedicated e2e seed) before the first run.
E2E_CLIENT_EMAIL=client@test.zaffa
E2E_CLIENT_PASSWORD=test-password-123
E2E_PLANNER_EMAIL=planner@test.zaffa
E2E_PLANNER_PASSWORD=test-password-123
E2E_ADMIN_EMAIL=admin@test.zaffa
E2E_ADMIN_PASSWORD=test-password-123
